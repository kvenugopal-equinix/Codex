WARROOM_DRY_RUN=true
WARROOM_LIVE_CALLING=false
WARROOM_TARGET_MODE=test          # test | roster
WARROOM_TEST_NUMBER=              # a phone you control, E.164
WARROOM_ALLOW_ROSTER_CALLS=false
# WARROOM_ROSTER=roster.xlsx
# WARROOM_JOIN_LOG=logs/join_log.csv
# WARROOM_ACTIVITY_WORKBOOK=/Users/you/OneDrive/War room activity.xlsx  # optional Excel report chosen in the app
# WARROOM_CALL_TIMEOUT=60            # seconds to wait for the callee to answer
# WARROOM_DIAL_METHOD=ui             # ui = in-meeting call-out (default); uri = separate outbound call
WARROOM_ZOOM_INVITE=false         # also invite the engineer as a Zoom contact (Invite > Contacts), same gates as the call
WARROOM_ZOOM_CONTACT_LOOKUP=name  # match the roster name exactly in Zoom's Contacts tab; email is the legacy lookup
WARROOM_TEST_ZOOM_CONTACT=        # exact contact name for test mode only; roster mode uses the roster name
WARROOM_TEST_ZOOM_EMAIL=          # test mode invites only this Zoom account (roster mode uses the roster zoom_email)
WARROOM_VOICE=true                # spoken welcome (macOS `say`) instead of a chat message
# WARROOM_VOICE_ROUTE=share       # share (default): played into the meeting as Zoom shared computer sound; local: this Mac's speakers only
WARROOM_VOICE_IN_DRY_RUN=false    # set true to hear it while testing
# WARROOM_VOICE_NAME=Samantha
# WARROOM_VOICE_MESSAGE=Custom welcome text
# Join watcher (`warroom.cli watch`)
# WARROOM_POLL_SECONDS=3             # seconds between participant-list reads (min 1)
# WARROOM_GRACE_SECONDS=10           # wait after the welcome, then re-check, before calling (min 0)
# WARROOM_MAX_CALLS_PER_HOUR=3       # calls the watcher may place per rolling hour (whole number, min 1)
# WARROOM_SKIP_IF_SUPPORT_PRESENT=true
# WARROOM_TRUST_DISPLAY_NAMES=false  # treat a roster name in the list as that engineer (spoofable)
# WARROOM_IGNORE_NAMES=              # comma-separated names never treated as visitors (note-takers, bots)
